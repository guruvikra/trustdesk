# ─────────────────────────────────────────────────────────────────────────────
# TrustDesk configuration
#   1. cp .env.example .env
#   2. fill in what you need (everything is optional — the app runs with none of it)
#   3. restart: npm start
# .env is git-ignored, so your keys never leave your machine.
#
# Helpdesk credentials (Zendesk, Freshdesk, Intercom, Front, Linear API keys/tokens)
# do NOT go here: enter them in the app under Integrations → Connect. They are
# stored per workspace and never returned to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI model ─────────────────────────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
# Without a key, TrustDesk uses its built-in offline policy engine. Guardrails,
# approvals and Autopilot safety rules apply either way.
GEMINI_API_KEY=

# Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# "gemini" uses the key above, "mock" forces the offline engine.
# Leave empty to auto-select (gemini when a key is set).
LLM_PROVIDER=

# Pause between eval cases when using a hosted model (free tier is about 10 requests/min)
EVAL_CASE_DELAY_MS=4000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# Public address of this server. Used to build OAuth redirect URLs:
#   <PUBLIC_URL>/api/oauth/<zendesk|intercom|front|linear>/callback
PUBLIC_URL=http://localhost:8000

# Password for the demo accounts (agent@ / manager@ / admin@trustdesk.dev)
DEMO_PASSWORD=trustdesk

# Optional: if set, inbound webhooks must send the header  X-TrustDesk-Secret: <value>
WEBHOOK_SECRET=

# Optional: path of the demo-workspace database file (":memory:" = nothing saved)
# TRUSTDESK_DB=./trustdesk_node.db

# ── OAuth apps (optional) ────────────────────────────────────────────────────
# Only needed for the "Connect with <app>" OAuth button. API keys work without these.
# Create an OAuth app in each product, register the redirect URL shown in the
# app's Connect panel, then paste the client ID and secret here.
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
FRONT_CLIENT_ID=
FRONT_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
