# Copy to .env (repo root) and restart the server.

# Hosted model (free key: https://aistudio.google.com/apikey). Without it the offline policy engine is used.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=gemini        # or "mock" to force the offline engine

# Public URL of this server — used for OAuth redirect URLs (register <PUBLIC_URL>/api/oauth/<app>/callback in each app)
# PUBLIC_URL=http://localhost:8000

# OAuth apps (optional — every integration also works with an API key/token entered in the UI)
# ZENDESK_CLIENT_ID=
# ZENDESK_CLIENT_SECRET=
# INTERCOM_CLIENT_ID=
# INTERCOM_CLIENT_SECRET=
# FRONT_CLIENT_ID=
# FRONT_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# PORT=8000
# DEMO_PASSWORD=trustdesk     # password for the demo accounts
# WEBHOOK_SECRET=             # if set, webhooks must send header X-TrustDesk-Secret
# TRUSTDESK_DB=./trustdesk_node.db
